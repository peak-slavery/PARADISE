# Ei Flow · Shanks — copy to .env and fill in secrets
BOT_ID=shanks
BOT_NAME=Shanks
BOT_VERSION=1.0.0
EMBED_COLOR=#C0392B
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1544550226373640263

# Runtime control
HMAC_SECRET=
OWNER_IDS=
DASHBOARD_URL=https://paradise-engine.vercel.app
DEV_GUILD_ID=
MAIN_GUILD_ID=
DEV_AUTH_CHANNEL_ID=

# Runtime database and Redis credentials are hydrated from the dashboard vault.
MONGODB_DB=eiflow
MONGODB_SECONDARY_DB=eipointsecurity

# Bad-words SLM classifier (NVIDIA NIM primary, Cerebras fallback).
NVIDIA_NIM_API_KEY=
CEREBRAS_API_KEY=
SECURITY_SLM_MODEL=nvidia/nemotron-3.5-content-safety
SECURITY_SLM_FALLBACK_MODEL=qwen-3.8-27b

# Observability and health
SENTRY_DSN=
LOG_LEVEL=info
PORT=3000
HEALTH_TOKEN=
REDIS_DAILY_COMMAND_BUDGET=8000
