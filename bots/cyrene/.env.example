# Paradise AI — copy to .env and fill in
BOT_ID=cyrene
BOT_NAME=Cyrene
BOT_VERSION=1.0.0
EMBED_COLOR=#B76EFF
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Shared across all 8 bots
HMAC_SECRET=
OWNER_IDS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MONGODB_URI=
MONGODB_DB=eiflow
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
LOG_LEVEL=info
PORT=3000

# AI providers — tried in order: Groq, then Gemini, then OpenRouter.
# At least one is required for /ask and /cyrene to produce a reply.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CYRENE_MODEL=openai/gpt-oss-20b
ASSISTANT_MODEL=mistral-small-latest
