# Paradise AI · Cyrene — copy to .env and fill in secrets
BOT_ID=cyrene
BOT_NAME=Cyrene
BOT_VERSION=1.0.0
EMBED_COLOR=#B76EFF
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1544546018807513131

# Runtime control
HMAC_SECRET=
OWNER_IDS=1479589523426902208
DASHBOARD_URL=https://paradise-engine.vercel.app
DEV_GUILD_ID=
MAIN_GUILD_ID=
DEV_AUTH_CHANNEL_ID=

# Runtime database and Redis credentials are hydrated from the dashboard vault.
MONGODB_DB=eiflow
MONGODB_SECONDARY_DB=eipointsecurity

# Observability and health
SENTRY_DSN=
LOG_LEVEL=info
PORT=3000
HEALTH_TOKEN=
REDIS_DAILY_COMMAND_BUDGET=8000

# AI providers — tried in order: Groq, then Gemini, then OpenRouter.
# At least one is required for /ask and /cyrene to produce a reply.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CYRENE_MODEL=openai/gpt-oss-20b
ASSISTANT_MODEL=mistral-small-latest
