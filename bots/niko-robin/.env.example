# Ei Flow · Niko Robin — copy to .env and fill in secrets
BOT_ID=niko-robin
BOT_NAME=Niko Robin
BOT_VERSION=1.0.0
EMBED_COLOR=#8E44AD
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Search providers — Brave is tried first, SerpAPI is the fallback.
# Configure either one (or both) for /search to work.
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=

# Search-result summarizer SLM (ModelScope).
MODELSCOPE_API_KEY=
SEARCH_SLM_MODEL=Qwen/Qwen3.5-35B-A3B

# Runtime control
HMAC_SECRET=
OWNER_IDS=
DASHBOARD_URL=https://ei-point-dashboard.vercel.app
DEV_GUILD_ID=
MAIN_GUILD_ID=
DEV_AUTH_CHANNEL_ID=

# Runtime database and Redis credentials are hydrated from the dashboard vault.
MONGODB_DB=eiflow
MONGODB_SECONDARY_DB=eipointsecurity

# Observability and health
SENTRY_DSN=
LOG_LEVEL=info
PORT=3000
HEALTH_TOKEN=
REDIS_DAILY_COMMAND_BUDGET=8000
