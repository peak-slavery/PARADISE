# Ei Flow · Niko Robin — copy to .env and fill in
BOT_ID=niko-robin
BOT_NAME=Niko Robin
BOT_VERSION=1.0.0
EMBED_COLOR=#8E44AD
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Search providers — Brave is tried first, SerpAPI is the fallback.
# Configure either one (or both) for /search to work.
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=

# Shared across all 8 bots
HMAC_SECRET=
OWNER_IDS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MONGODB_URI=
MONGODB_DB=eiflow
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
LOG_LEVEL=info
PORT=3000
