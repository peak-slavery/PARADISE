# Ei Flow · Zoro — copy to .env and fill in secrets
BOT_ID=zoro
BOT_NAME=Zoro
BOT_VERSION=1.0.0
EMBED_COLOR=#2ECC71
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Runtime control
HMAC_SECRET=
OWNER_IDS=
DASHBOARD_URL=https://ei-point-dashboard.vercel.app
DEV_GUILD_ID=
MAIN_GUILD_ID=
DEV_AUTH_CHANNEL_ID=

# Runtime database and Redis credentials are hydrated from the dashboard vault.
MONGODB_DB=eiflow
MONGODB_SECONDARY_DB=eipointsecurity

# Observability and health
SENTRY_DSN=
LOG_LEVEL=info
PORT=3000
HEALTH_TOKEN=
REDIS_DAILY_COMMAND_BUDGET=8000
CEREBRAS_API_KEY=
ZORO_SLM_MODEL=qwen-3.8-27b
ZORO_SLM_MAX_TOKENS=64
ZORO_SLM_CONTEXT_CHARS=2000
