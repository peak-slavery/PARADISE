# Vercel deployment environment for the Ei Point dashboard.
# Add these values in Vercel Project Settings -> Environment Variables.
# Never commit real credentials or use this file as a production secret store.

# Supabase dashboard authentication and server-side access
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Encrypted provider-secret vault
SECRET_VAULT_MASTER_KEY=
SECRET_VAULT_SALT=

# Signed bot-to-dashboard requests
HMAC_SECRETS_JSON=

# Public deployment origin and fixed guild routing
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
DASHBOARD_URL=https://your-project.vercel.app
DEV_GUILD_ID=
MAIN_GUILD_ID=
DEV_AUTH_CHANNEL_ID=

# Production must not use demo fixtures
DEMO_MODE=false
