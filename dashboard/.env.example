# ---------------------------------------------------------------------------
# Paradise Engine — dashboard environment
# Copy to `.env.local` for local preview. Production must provide Supabase
# credentials; demo mode is only enabled explicitly with DEMO_MODE=true.
# ---------------------------------------------------------------------------

# --- Supabase (source of truth: auth, servers, config, security) ---
# Browser-safe: used by the OAuth sign-in flow and the SSR cookie client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- MongoDB Atlas (high-volume activity: logs, xp, games, inventories) ---
# Server-only. Reads the `logs` collection for the live activity stream.
MONGODB_URI=
MONGODB_DB=eiflow

# --- HMAC (bot <-> dashboard internal REST calls) ---
# Production requires a unique secret per bot. Keep this server-only.
HMAC_SECRET=
HMAC_SECRETS_JSON=

# --- Explicit local/demo behavior ---
DEMO_MODE=false

# --- OAuth redirect override (defaults to <origin>/auth/callback) ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
