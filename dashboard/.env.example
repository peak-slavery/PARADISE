# ---------------------------------------------------------------------------
# Paradise Engine — dashboard environment
# Copy to `.env.local` for local preview. Production must provide Supabase
# credentials; demo mode is only enabled explicitly with DEMO_MODE=true.
# ---------------------------------------------------------------------------

# --- Supabase (source of truth: auth, servers, config, security) ---
# Browser-safe: used by the OAuth sign-in flow and the SSR cookie client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM vault key material. Generate random base64 values; never commit
# them. These are the only values needed to decrypt encrypted provider records.
SECRET_VAULT_MASTER_KEY=
SECRET_VAULT_SALT=

# MongoDB, Redis, Firebase, Cloudflare, and runtime Supabase credentials are
# not dashboard env vars. Add them through the master-only /api/secret vault
# API as encrypted records. The dashboard's own Supabase values above remain
# required for auth and RLS.

# --- HMAC (bot <-> dashboard internal REST calls) ---
# Each Render bot has its own 64-hex HMAC_SECRET. Production must receive a
# complete JSON map with one unique value for every bot; the route rejects
# incomplete maps and duplicate values.
HMAC_SECRET=
HMAC_SECRETS_JSON=

# Bot-to-dashboard vault reads and fixed-guild review routing.
DASHBOARD_URL=http://localhost:4173
DEV_GUILD_ID=
MAIN_GUILD_ID=
DEV_AUTH_CHANNEL_ID=

# --- Explicit local/demo behavior ---
DEMO_MODE=false

# --- OAuth redirect override (defaults to <origin>/auth/callback) ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
