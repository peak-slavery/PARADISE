{
  "name": "eiflow",
  "version": "0.1.0",
  "private": true,
  "description": "Discord multi-bot ecosystem: 8 isolated bots + Vercel control-plane dashboard",
  "type": "module",
  "workspaces": [
    "packages/*",
    "bots/*",
    "dashboard"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "vite": "^7.3.1"
  },
  "scripts": {
    "build": "npm run build -w @eipoint/dashboard",
    "start": "npm run start -w @eipoint/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test scripts/credential-keys.test.mjs scripts/bot-env.test.mjs scripts/check-local-config.test.mjs scripts/fleet.test.mjs scripts/pm2-config.test.mjs scripts/render-config.test.mjs scripts/restore-drill.test.mjs scripts/supabase-migrations.test.mjs scripts/triage-fleet.test.mjs && npm run test --workspaces --if-present",
    "test:local": "node scripts/test-local-stack.mjs",
    "deploy:commands": "node scripts/deploy-commands-all.mjs",
    "check:bots": "node scripts/check-all-bots.mjs",
    "check:local": "node scripts/check-local-config.mjs",
    "dev:dashboard": "node scripts/run-dashboard.mjs",
    "audit": "npm audit --audit-level=high",
    "check:deploy": "node scripts/check-deploy.mjs",
    "migrate:supabase": "node scripts/apply-supabase-migrations.mjs",
    "smoke:production": "tsx scripts/production-smoke.mjs",
    "monitor:production": "node scripts/production-monitor.mjs",
    "watchdog": "node scripts/watchdog.mjs",
    "triage:fleet": "node scripts/triage-fleet.mjs",
    "smoke:luffy": "tsx scripts/luffy-smoke.mjs",
    "archive:retention": "node scripts/archive-retention.mjs",
    "drill:restore": "node scripts/restore-drill.mjs",
    "drill:rollback": "node scripts/rollback-drill.mjs",
    "start:moderation": "npm run dev -w @eiflow/bot-shanks",
    "start:logging": "npm run dev -w @eiflow/bot-sanji",
    "start:antinuke": "npm run dev -w @eiflow/bot-zoro",
    "start:welcome": "npm run dev -w @eiflow/bot-boahancock",
    "start:levelup": "npm run dev -w @eiflow/bot-nami",
    "start:cardgame": "npm run dev -w @eiflow/bot-luffy",
    "start:search": "npm run dev -w @eiflow/bot-niko-robin",
    "start:ai": "npm run dev -w @eiflow/bot-cyrene"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^10.11.0",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
