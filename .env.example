# ---------------------------------------------------------------------------
# Ei Flow / Ei Point — shared environment contract
# Copy to .env locally. On Render/Vercel set only the host-safe values below.
# NOTHING here is ever committed with real values.
# ---------------------------------------------------------------------------

# --- Bot identity (per-bot, overridden in each bot/.env) ---
BOT_ID=shanks
BOT_NAME=Shanks
BOT_VERSION=1.0.0
EMBED_COLOR=#C0392B
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --- Control plane ---
# Discord user IDs allowed to bypass all cooldowns / antinuke. Comma separated.
OWNER_IDS=
# Per-bot HMAC secret for bot <-> dashboard REST calls.
# Generate a different 64-hex value for every bot and place that bot's value
# in its Render service. The dashboard receives the eight-value JSON map below.
HMAC_SECRET=
# Production format: {"shanks":"<64 hex>","sanji":"<64 hex>",...}
HMAC_SECRETS_JSON=
DASHBOARD_URL=http://localhost:4173

# Fixed guild review targets. Keep blank until the real IDs are supplied.
DEV_GUILD_ID=
MAIN_GUILD_ID=
DEV_AUTH_CHANNEL_ID=

# MongoDB, Redis, runtime Supabase, Firebase, and Cloudflare credentials are
# intentionally absent here. Store them as encrypted secret_records through the
# master-only dashboard vault API. Do not add them to Render/Vercel env vars.
# The bot fetches allowlisted records over the signed internal vault endpoint.

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Health / uptime endpoint ---
PORT=3000
# Optional bearer token for detailed /health diagnostics. Without it, public
# health checks return status only while preserving 200/503 monitoring semantics.
HEALTH_TOKEN=

# --- Free-tier quota circuit breakers (alert at 80%) ---
REDIS_DAILY_COMMAND_BUDGET=8000

# --- Optional external providers (Search + AI bots only) ---
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
