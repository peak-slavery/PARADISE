# ---------------------------------------------------------------------------
# Ei Flow / Ei Point — shared environment contract
# Copy to .env locally. On Render/Vercel set these as dashboard env vars.
# NOTHING here is ever committed with real values.
# ---------------------------------------------------------------------------

# --- Bot identity (per-bot, overridden in each bot/.env) ---
BOT_ID=shanks
BOT_NAME=Shanks
BOT_VERSION=1.0.0
EMBED_COLOR=#C0392B
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --- Control plane ---
# Discord user IDs allowed to bypass all cooldowns / antinuke. Comma separated.
OWNER_IDS=
# Per-deployment HMAC secret for bot <-> dashboard REST calls.
# Production dashboard uses HMAC_SECRETS_JSON with one unique secret per bot.
HMAC_SECRET=
HMAC_SECRETS_JSON=

# --- Supabase (source of truth: auth, servers, config, security) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- MongoDB Atlas (high-volume activity: logs, xp, games, inventories, ai) ---
# Use mongodb+srv:// (TLS by default), or mongodb:// with tls=true/ssl=true.
# Plaintext MongoDB URIs are rejected by the runtime.
MONGODB_URI=
MONGODB_DB=eiflow

# --- Upstash Redis (rate limits, antinuke counters, caches) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Health / uptime endpoint ---
PORT=3000
# Optional bearer token for detailed /health diagnostics. Without it, public
# health checks return status only while preserving 200/503 monitoring semantics.
HEALTH_TOKEN=

# --- Free-tier quota circuit breakers (alert at 80%) ---
REDIS_DAILY_COMMAND_BUDGET=8000

# --- Optional external providers (Search + AI bots only) ---
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
